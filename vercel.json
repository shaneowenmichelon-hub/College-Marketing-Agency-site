{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "^college-marketing-agency-site\\.vercel\\.app$" }],
      "destination": "https://collegiateagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "^college-marketing-agency-site-s8tw\\.vercel\\.app$" }],
      "destination": "https://collegiateagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "^college-marketing-agency-site-ksro\\.vercel\\.app$" }],
      "destination": "https://collegiateagency.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/article-art",
      "schedule": "0 6 1-31/2 * *"
    },
    {
      "path": "/api/cron/mail-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "20 */6 * * *"
    }
  ]
}
