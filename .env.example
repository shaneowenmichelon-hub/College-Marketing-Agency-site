# Copy to .env.local for local dev, and add these in Vercel → Project → Settings →
# Environment Variables for production. Everything here is OPTIONAL to RUN the site —
# forms validate and succeed with all of these unset (email no-ops + logs; analytics
# simply doesn't load). Set them to turn on real delivery and tracking.

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Get an API key at resend.com. Leave RESEND_API_KEY blank to DISABLE email:
# forms still work, and each send is logged instead of delivered.
RESEND_API_KEY=
# The verified sending identity. Must be on a domain you've verified in Resend
# (SPF/DKIM/DMARC) or confirmation emails will land in spam.
EMAIL_FROM="Collegiate Hospitality <hello@collegiatehospitality.com>"
# Destination for ALL internal notifications (brand + ambassador + portal signups
# and submissions). Defaults to shane@zmmevents.com in code; override here.
AGENCY_INBOX=shane@zmmevents.com

# ── Private file storage (Vercel Blob) — ambassador IDs + proof-of-work files ─
# Create a Blob store in Vercel → Storage; this token is added automatically when
# you link it, or paste it here. If UNSET, forms still submit and the internal
# email flags the file as "not uploaded — storage not configured".
# NOTE: Vercel Blob serves unguessable-but-public URLs. For true private/expiring
# access to ID images, swap src/lib/storage.ts to S3/R2 signed URLs (see file).
BLOB_READ_WRITE_TOKEN=
# How long ID images are kept before deletion (used by the future cleanup routine).
ID_RETENTION_DAYS=90

# ── Ambassador job portal ────────────────────────────────────────────────────
# Shared access code you give approved ambassadors (they enter it + their .edu
# email at /portal). Defaults to "collegiate2026" if unset. This is a shared
# secret, NOT per-user auth — see the TODO in src/lib/portal.ts.
PORTAL_ACCESS_CODE=
# Set to "false" to allow ambassadors to hold more than one active job at a time.
ONE_JOB_AT_A_TIME=true

# ── Analytics & pixels (all optional; load only AFTER cookie consent) ────────
NEXT_PUBLIC_GA_ID=                    # GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=                   # Google Tag Manager ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=      # LinkedIn Insight Tag partner id (optional)
NEXT_PUBLIC_META_PIXEL_ID=            # Meta/Facebook Pixel id (optional)
