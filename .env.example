# Copy to .env.local and fill in before wiring real form delivery.
# The API routes read these at runtime. With them unset, forms still validate,
# log to the server console, and return success (safe for local dev / preview).

# Where brand "Get Started" / contact submissions should be delivered.
# e.g. a Formspree endpoint, a Resend-backed handler, or your CRM webhook.
CONTACT_ENDPOINT=

# Where student ambassador applications should be delivered.
APPLY_ENDPOINT=
