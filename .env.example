# Copy to .env.local for local dev, and add these in Vercel → Project → Settings →
# Environment Variables for production. Everything here is OPTIONAL to RUN the site —
# forms validate and succeed with all of these unset (email no-ops + logs; analytics
# simply doesn't load). Set them to turn on real delivery and tracking.

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Get an API key at resend.com. Leave RESEND_API_KEY blank to DISABLE email:
# forms still work, and each send is logged instead of delivered.
RESEND_API_KEY=
# The verified sending identity. Must be on a domain you've verified in Resend
# (SPF/DKIM/DMARC) or confirmation emails will land in spam.
EMAIL_FROM="Collegiate Agency <hello@collegiateagency.com>"
# Destination for ALL internal notifications (brand + ambassador + portal signups
# and submissions). Defaults to shane@zmmevents.com in code; override here.
AGENCY_INBOX=shane@zmmevents.com

# ── Private file storage (Vercel Blob) — ambassador IDs + proof-of-work files ─
# Create a Blob store in Vercel → Storage; this token is added automatically when
# you link it, or paste it here. If UNSET, forms still submit and the internal
# email flags the file as "not uploaded — storage not configured".
# NOTE: Vercel Blob serves unguessable-but-public URLs. For true private/expiring
# access to ID images, swap src/lib/storage.ts to S3/R2 signed URLs (see file).
BLOB_READ_WRITE_TOKEN=
# How long ID images are kept before deletion (used by the future cleanup routine).
ID_RETENTION_DAYS=90

# ── Ambassador job portal ────────────────────────────────────────────────────
# Shared access code you give approved ambassadors (they enter it + their .edu
# email at /portal). Defaults to "collegiate2026" if unset. This is a shared
# secret, NOT per-user auth — see the TODO in src/lib/portal.ts.
PORTAL_ACCESS_CODE=
# Set to "false" to allow ambassadors to hold more than one active job at a time.
ONE_JOB_AT_A_TIME=true

# ── Analytics & pixels (all optional; load only AFTER cookie consent) ────────
NEXT_PUBLIC_GA_ID=                    # GA4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=                   # Google Tag Manager ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=      # LinkedIn Insight Tag partner id (optional)
NEXT_PUBLIC_META_PIXEL_ID=            # Meta/Facebook Pixel id (optional)

# ── Pipeline board (/private-ops-7f3a/pipeline) ──────────────────────────────
# REQUIRED. Signs the admin session cookie. Without it the admin area fails
# closed in production — it used to fall back to a key derived from a constant
# in src/lib/admin-auth.ts, which meant anyone who could read the repo could
# forge a session. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# sha256 of the access code the team types in. Defaults to the code
# "collegiate" if unset, which you do not want on a live board.
# Generate with: printf 'your-code' | sha256sum
ADMIN_ACCESS_CODE_SHA256=
# Postgres for the pipeline (Vercel → Storage → Create → Postgres sets this for
# you). If UNSET, forms still submit and still email — they just don't appear
# on the board.
DATABASE_URL=
# Authenticates the every-10-minutes mail sync. This route FAILS CLOSED without
# it, unlike /api/cron/article-art. Generate with: openssl rand -hex 32
CRON_SECRET=
# Encrypts stored submission records. UNSET MEANS SUBMISSIONS ARE NEVER SAVED
# to Blob storage — see src/lib/admin-analytics.ts:158.
ADMIN_DATA_SECRET=

# ── Gmail sync (reads headers + labels only, never message bodies) ───────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Web application. Add https://collegiateagency.com/api/gmail/callback as an
# authorised redirect URI. Enable the Gmail API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the refresh token instead of storing it in the database. The
# connect flow at /api/gmail/connect stores one for you, so leave this blank.
GOOGLE_REFRESH_TOKEN=
# Optional: only needed if the deployed URL differs from the request origin.
GOOGLE_REDIRECT_URI=
# Optional: any send-as aliases you reply from, comma separated. Without these
# a reply sent from an alias won't be recognised as yours.
GMAIL_SELF_ADDRESSES=
# Gmail labels that move a deal to stage 3 and 4. Nesting is fine —
# "Agency/Proposal Sent" matches on the last segment.
GMAIL_LABEL_PROPOSAL=Proposal Sent
GMAIL_LABEL_CAMPAIGN=Campaign Live
